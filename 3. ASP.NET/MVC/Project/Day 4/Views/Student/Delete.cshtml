@model Student
@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h2>Are you sure you want to delete this ?</h2>
<h3>@Model.Name</h3>
<h3>@Model.Age</h3>
<h3>@Model.Department.Name</h3>

<form asp-action="ConfirmDelete" asp-controller="Student" asp-route-id="@Model.Id" method="post">
    
    <input type="hidden" asp-for="@Model.Id" />

    <input type="submit" value="Delete" class="btn btn-danger"/>

</form>

<a asp-action="ShowAll" asp-controller="Student" class="btn btn-secondary mt-1 mb-3">Back To List</a>


