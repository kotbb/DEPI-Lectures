@model List<Student>
<h1>Students</h1>

<a asp-action="Add" asp-controller="Student" class="btn btn-success mt-3 mb-3">New</a>

<table class="table table-hover table-bordered">
    <tr>
        <th>Number</th>
        <th>Name</th>
        <th>Age</th>
        <th>Department</th>
    </tr>
    @foreach (var item in Model)
    {
    <tr>
            <th>@item.Id</th>
            <th>@item.Name</th>
            <th>@item.Age</th>
            <th>@item.Department?.Name</th>
            <th><a asp-action="Edit" asp-controller="Student" asp-route-id="@item.Id" class="btn btn-outline-success">Edit</a>
                <a asp-action="Delete" asp-controller="Student" asp-route-id="@item.Id" class="btn btn-outline-danger">Delete</a>
            </th>
    </tr>  
    }
</table>
